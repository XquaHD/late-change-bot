# Copy this file to .env and fill in your values.
# (If running via GitHub Actions, put these in repo Settings > Secrets/Variables
# instead of a .env file - see README.md)

TWITTER_USERNAME=aflwomens
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# From a logged-in spare/burner X account's browser cookies (DevTools >
# Application > Cookies > x.com). These expire every so often - if the bot
# suddenly stops fetching tweets, re-extract fresh values here.
TWSCRAPE_AUTH_TOKEN=paste_auth_token_cookie_value_here
TWSCRAPE_CT0=paste_ct0_cookie_value_here

KEYWORDS=late change
PING_TARGET=everyone
CHECK_COUNT=20
POLL_INTERVAL_SECONDS=120
RUN_MODE=once
